@{
    ViewBag.Title = "Bài 4";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <title>TO-DO LIST</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 40px;
            font-family: Arial, Helvetica, sans-serif;
            background-color: white;
        }

        .todo-container {
            width: 530px;
            margin: 0 auto;
            background-color: #f1f1f1;
            padding: 20px 25px 35px 25px;
        }

        .input-area {
            display: flex;
            height: 67px;
        }

        #taskInput {
            flex: 1;
            border: none;
            background-color: #344458;
            color: white;
            padding: 0 18px;
            font-size: 25px;
            font-weight: bold;
            outline: none;
        }

            #taskInput::placeholder {
                color: #999;
            }

        #btnAdd {
            width: 68px;
            border: none;
            background-color: #16cdb1;
            color: white;
            font-size: 35px;
            font-weight: bold;
            cursor: pointer;
        }

            #btnAdd:hover {
                background-color: #12bda3;
            }

        #taskList {
            background-color: white;
        }

        .task {
            min-height: 64px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid #ddd;
            padding: 0 18px;
            background-color: white;
            font-size: 23px;
        }

            .task input[type="checkbox"] {
                width: 18px;
                height: 18px;
                margin-right: 14px;
                cursor: pointer;
            }

            .task span {
                cursor: pointer;
            }

            .task.completed span {
                text-decoration: line-through;
                color: #ccc;
            }

        .delete {
            margin-left: auto;
            color: #e74c3c;
            font-size: 22px;
            cursor: pointer;
            display: none;
        }

        .task:hover .delete {
            display: block;
        }
    </style>
</head>

<body>

    <div class="todo-container">

        <div class="input-area">

            <input type="text"
                   id="taskInput"
                   placeholder="Enter a task" />

            <button id="btnAdd">+</button>

        </div>

        <div id="taskList">

            <div class="task completed">

                <input type="checkbox" checked />

                <span>Việc 1</span>

                <span class="delete">×</span>

            </div>

            <div class="task">

                <input type="checkbox" />

                <span>Việc 2</span>

                <span class="delete">×</span>

            </div>

            <div class="task">

                <input type="checkbox" />

                <span>Việc 3</span>

                <span class="delete">×</span>

            </div>

        </div>

    </div>

    <script src="~/Scripts/bai4.js"></script>

</body>
</html>