@{
    ViewBag.Title = "Bài 2";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <title>Thông tin giao hàng</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 10px;
            font-family: Arial, Helvetica, sans-serif;
            color: #333;
        }

        .container {
            width: 665px;
            margin: 0 auto;
            border: 1px solid #222;
            padding: 8px 5px 12px 5px;
        }

        h2 {
            margin: 0 0 8px 0;
            padding-bottom: 6px;
            border-bottom: 1px solid #ddd;
            font-size: 18px;
            font-weight: normal;
        }

        .form-row {
            display: flex;
            gap: 10px;
            margin-bottom: 7px;
        }

        .form-group {
            flex: 1;
        }

            .form-group.full {
                width: 50%;
                margin-left: 50%;
            }

            .form-group label {
                display: block;
                font-size: 11px;
                font-weight: bold;
                margin-bottom: 4px;
            }

            .form-group input {
                width: 100%;
                height: 25px;
                border: 1px solid #ddd;
                border-radius: 3px;
                padding: 4px 7px;
                font-size: 13px;
                outline: none;
            }

                .form-group input:focus {
                    border-color: #80bdff;
                }

        .error {
            display: block;
            min-height: 14px;
            color: red;
            font-size: 11px;
            margin-top: 2px;
        }

        .buttons {
            border-top: 1px solid #ddd;
            margin-top: 2px;
            padding-top: 8px;
            margin-left: 50%;
        }

        .buttons-title {
            font-size: 11px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        button {
            border: none;
            border-radius: 3px;
            padding: 6px 10px;
            color: white;
            cursor: pointer;
            font-size: 11px;
            margin-right: 5px;
        }

        #btnVanPhong {
            background-color: #337ab7;
        }

        #btnNhaRieng {
            background-color: #5cb85c;
        }

        #btnLuu {
            background-color: #e95353;
            margin-top: 10px;
        }

        #thongBaoLoai {
            color: #333;
            font-size: 12px;
            margin-top: 5px;
            min-height: 16px;
        }

        .save-row {
            border-top: 1px solid #ddd;
            margin-top: 5px;
            padding-top: 5px;
            margin-left: 50%;
        }
    </style>
</head>

<body>

    <div class="container">

        <h2>Thông tin giao hàng</h2>

        <div class="form-row">

            <div class="form-group">
                <label>Tên</label>

                <input type="text"
                       id="ten"
                       autofocus />

                <span id="errTen" class="error"></span>
            </div>

            <div class="form-group">
                <label>Địa chỉ nhận hàng</label>

                <input type="text"
                       id="diaChi" />

                <span id="errDiaChi" class="error"></span>
            </div>

        </div>


        <div class="form-row">

            <div class="form-group">
                <label>Số điện thoại</label>

                <input type="text"
                       id="soDienThoai" />

                <span id="errSoDienThoai" class="error"></span>
            </div>

            <div class="form-group">
                <label>Tỉnh / thành phố</label>

                <input type="text"
                       id="tinhThanhPho" />

                <span id="errTinhThanhPho" class="error"></span>
            </div>

        </div>


        <div class="form-row">

            <div class="form-group full">
                <label>Quận / Huyện</label>

                <input type="text"
                       id="quanHuyen" />

                <span id="errQuanHuyen" class="error"></span>
            </div>

        </div>


        <div class="form-row">

            <div class="form-group full">
                <label>Phường / Xã</label>

                <input type="text"
                       id="phuongXa" />

                <span id="errPhuongXa" class="error"></span>
            </div>

        </div>


        <div class="buttons">

            <div class="buttons-title">
                Lựa chọn tên cho địa chỉ thường dùng
            </div>

            <button type="button" id="btnVanPhong">
                Văn phòng
            </button>

            <button type="button" id="btnNhaRieng">
                Nhà riêng
            </button>

            <div id="thongBaoLoai"></div>

        </div>


        <div class="save-row">

            <button type="button" id="btnLuu">
                Lưu
            </button>

        </div>

    </div>


    <script src="~/Scripts/bai2.js"></script>

</body>
</html>