@{
    ViewBag.Title = "Bài 5";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <title>Progress Bar</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px;
            font-family: Arial, Helvetica, sans-serif;
            background-color: white;
        }

        .container {
            width: 625px;
            margin: 0 auto;
        }

        .progress {
            width: 100%;
            height: 30px;
            background-color: #ddd;
            border-radius: 20px;
            overflow: hidden;
            margin-bottom: 70px;
        }

        .progress-bar {
            height: 100%;
            width: 0%;
            border-radius: 20px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding-right: 12px;
            color: white;
            font-size: 20px;
            font-weight: bold;
            transition: width 0.5s ease;
        }

        .progress:nth-child(1) .progress-bar {
            background-color: #7020a5;
        }

        .progress:nth-child(2) .progress-bar {
            background-color: #08796f;
        }

        .progress:nth-child(3) .progress-bar {
            background-color: #f06a0a;
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="progress">
            <div class="progress-bar" id="progress1">
                60%
            </div>
        </div>

        <div class="progress">
            <div class="progress-bar" id="progress2">
                30%
            </div>
        </div>

        <div class="progress">
            <div class="progress-bar" id="progress3">
                53%
            </div>
        </div>

    </div>

    <script src="~/Scripts/bai5.js"></script>

</body>
</html>