@{
    ViewBag.Title = "Bài 1";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <title>Phiếu tham gia CLB Tin học LUBU</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px;
            font-family: Arial, Helvetica, sans-serif;
            background-color: white;
            color: #333;
        }

        .container {
            width: 700px;
            margin: 0 auto;
        }

        h1 {
            text-align: center;
            font-size: 25px;
            margin: 0 0 18px 0;
            font-weight: bold;
        }

            h1 span {
                color: #00a9e0;
            }

        .form-box {
            width: 100%;
            border: 1px solid #666;
            padding: 15px 20px;
        }

        .row {
            display: flex;
            align-items: center;
            min-height: 45px;
        }

            .row > label:first-child {
                width: 135px;
                flex-shrink: 0;
                font-size: 16px;
            }

        input[type="text"],
        input[type="number"] {
            width: 220px;
            height: 30px;
            border: 1px solid #aaa;
            padding: 4px 8px;
            font-size: 14px;
        }

        select {
            width: 150px;
            height: 30px;
            border: 1px solid #aaa;
            padding-left: 5px;
            font-size: 14px;
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 18px;
        }

            .checkbox-group label {
                width: auto !important;
                display: flex;
                align-items: center;
                font-size: 15px;
            }

            .checkbox-group input {
                margin-right: 5px;
            }

        #soTruong {
            font-style: italic;
        }

        #ketQuaNgoaiNgu {
            margin-left: 20px;
            color: red;
            font-style: italic;
        }

        button {
            padding: 6px 15px;
            font-size: 14px;
            border: 1px solid #888;
            background-color: #f5f5f5;
            cursor: pointer;
        }

            button:hover {
                background-color: #e5e5e5;
            }

        #thongBao {
            margin-left: 135px;
            margin-top: 8px;
            font-style: italic;
        }

        .error {
            color: red;
            font-style: italic;
            margin-left: 15px;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>
            PHIẾU THAM GIA CLB TIN HỌC
            <span>LUBU</span>
        </h1>

        <div class="form-box">

            
            <div class="row">
                <label>Mã sinh viên:</label>

                <input type="text"
                       id="maSV"
                       placeholder="Nhập Mã SV" />

                <span id="errMaSV" class="error"></span>
            </div>


            
            <div class="row">
                <label>Họ và tên:</label>

                <input type="text"
                       id="hoTen"
                       maxlength="30"
                       placeholder="Nhập Họ và tên" />

                <span id="errHoTen" class="error"></span>
            </div>


            
            <div class="row">
                <label>Tuổi:</label>

                <input type="number"
                       id="tuoi"
                       placeholder="Nhập tuổi > 18" />

                <span id="errTuoi" class="error"></span>
            </div>


            
            <div class="row">
                <label>Ngoại ngữ:</label>

                <div class="checkbox-group">

                    <label>
                        <input type="checkbox"
                               name="ngoaiNgu"
                               value="Anh" />
                        Anh
                    </label>

                    <label>
                        <input type="checkbox"
                               name="ngoaiNgu"
                               value="Pháp" />
                        Pháp
                    </label>

                    <label>
                        <input type="checkbox"
                               name="ngoaiNgu"
                               value="Nhật" />
                        Nhật
                    </label>

                </div>

                <span id="ketQuaNgoaiNgu"></span>
            </div>


            
            <div class="row">
                <label>Chuyên ngành:</label>

                <select id="chuyenNganh">

                    <option value="HeThong">
                        Hệ thống
                    </option>

                    <option value="PhanMem">
                        Phần mềm
                    </option>

                    <option value="Mang">
                        Mạng máy tính
                    </option>

                </select>
            </div>


            
            <div class="row">
                <label>Sở trường:</label>

                <span id="soTruong">
                    Phân tích &amp; Thiết kế
                </span>
            </div>


            
            <div class="row">

                <label></label>

                <button type="button" id="btnDangKy">
                    Đăng ký
                </button>

            </div>


            
            <div id="thongBao"></div>

        </div>

    </div>


    
    <script src="~/Scripts/bai1.js"></script>

</body>
</html>